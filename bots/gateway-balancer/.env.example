# Secrets for the gateway balancer bot. Copy to .env (never committed), restrict it to the bot's user (chmod 600),
# and never bake it into an image. None of these values is ever logged, journaled or notified.

# Non-secret configuration file (see config/example.json and README.md).
GATEWAY_BALANCER_CONFIG=config/config.json

# The single EOA that signs on every chain (0x-prefixed 32-byte hex).
BALANCER_PRIVATE_KEY=

# One RPC URL per chain, in the variable named by that chain's `rpcUrlEnv` in the configuration.
ARBITRUM_RPC_URL=
BASE_RPC_URL=
ARC_RPC_URL=

# Required only when platform.notifications.providers.slack.enabled is true.
SLACK_WEBHOOK_URL=
