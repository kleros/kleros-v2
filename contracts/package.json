{
  "name": "@kleros/kleros-v2-contracts",
  "version": "2.0.0-rc.2",
  "description": "Smart contracts for Kleros version 2",
  "main": "./dist/cjs/deployments/index.js",
  "module": "./dist/esm/deployments/index.js",
  "types": "./dist/types/deployments/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types/deployments/index.d.ts",
      "node": {
        "import": "./dist/cjs/deployments/index.js",
        "require": "./dist/cjs/deployments/index.js"
      },
      "default": {
        "import": "./dist/esm/deployments/index.js",
        "require": "./dist/cjs/deployments/index.js"
      }
    },
    "./cjs/deployments": {
      "types": "./dist/types/deployments/index.d.ts",
      "import": "./dist/cjs/deployments/index.js",
      "require": "./dist/cjs/deployments/index.js",
      "default": "./dist/cjs/deployments/index.js"
    },
    "./esm/deployments": {
      "types": "./dist/types/deployments/index.d.ts",
      "import": "./dist/esm/deployments/index.js",
      "default": "./dist/esm/deployments/index.js"
    },
    "./utils": {
      "types": "./dist/types/deployments/utils.d.ts",
      "node": {
        "import": "./dist/cjs/deployments/utils.js",
        "require": "./dist/cjs/deployments/utils.js"
      },
      "default": {
        "import": "./dist/esm/deployments/utils.js",
        "require": "./dist/cjs/deployments/utils.js"
      }
    },
    "./viem": {
      "types": "./dist/types/deployments/viem.d.ts",
      "node": {
        "import": "./dist/cjs/deployments/viem.js",
        "require": "./dist/cjs/deployments/viem.js"
      },
      "default": {
        "import": "./dist/esm/deployments/viem.js",
        "require": "./dist/cjs/deployments/viem.js"
      }
    },
    "./ethers": {
      "types": "./dist/types/deployments/ethers.d.ts",
      "node": {
        "import": "./dist/cjs/deployments/ethers.js",
        "require": "./dist/cjs/deployments/ethers.js"
      },
      "default": {
        "import": "./dist/esm/deployments/ethers.js",
        "require": "./dist/cjs/deployments/ethers.js"
      }
    },
    "./deployments/*": "./deployments/*",
    "./contracts/*": "./contracts/*"
  },
  "files": [
    "dist",
    "contracts",
    "typechain-types",
    "deployments",
    "README.md"
  ],
  "repository": "git@github.com:kleros/kleros-v2.git",
  "homepage": "https://github.com/kleros/kleros-v2/tree/master/contracts#readme",
  "author": "Kleros",
  "license": "MIT",
  "engines": {
    "node": ">=16.0.0"
  },
  "volta": {
    "node": "20.20.0"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "scripts": {
    "build": "hardhat compile",
    "clean": "hardhat clean",
    "check": "hardhat check",
    "test": "TS_NODE_TRANSPILE_ONLY=1 hardhat test",
    "coverage": "scripts/coverage.sh",
    "start": "hardhat node --tags nop",
    "start-local": "scripts/run-pinned-script.sh start-local",
    "local:start-local": "hardhat node --tags Arbitration,HomeArbitrable,Resolver,ArgentinaConsumerProtectionDK --hostname 0.0.0.0",
    "deploy": "hardhat deploy",
    "deploy-local": "scripts/run-pinned-script.sh deploy-local",
    "local:deploy-local": "hardhat deploy --tags Arbitration,HomeArbitrable,Resolver --network localhost",
    "validate-upgrades": "openzeppelin-upgrades-core validate --exclude 'src/proxy/mock/**/*.sol' --exclude 'src/test/**/*.sol' artifacts/build-info",
    "validate-upgrades-against-deployed": "hardhat compare-storage",
    "simulate": "hardhat simulate:all",
    "simulate-local": "hardhat simulate:all --network localhost",
    "populate:local": "scripts/run-pinned-script.sh populate:local",
    "local:populate:local": "yarn hardhat populate:courts --from v2_devnet --network localhost && yarn hardhat populate:policy-registry --from v2_devnet --network localhost",
    "viem:generate-devnet": "NODE_NO_WARNINGS=1 wagmi generate -c wagmi.config.devnet.mts",
    "viem:generate-testnet": "NODE_NO_WARNINGS=1 wagmi generate -c wagmi.config.testnet.mts",
    "viem:generate-mainnet": "NODE_NO_WARNINGS=1 wagmi generate -c wagmi.config.mainnet.mts",
    "viem:generate-hardhat": "NODE_NO_WARNINGS=1 wagmi generate -c wagmi.config.hardhat.mts",
    "export:devnet": "yarn hardhat export --export deployments/arbitrumSepoliaDevnet.ts --network arbitrumSepoliaDevnet",
    "export:testnet": "yarn hardhat export --export deployments/arbitrumSepolia.ts --network arbitrumSepolia",
    "export:mainnet": "yarn hardhat export --export deployments/arbitrum.ts --network arbitrum",
    "viem:test": "NODE_NO_WARNINGS=1 NODE_OPTIONS=--experimental-fetch ts-node ./scripts/viemTest.ts",
    "bot:keeper": "NODE_NO_WARNINGS=1 NODE_OPTIONS=--experimental-fetch hardhat run ./scripts/keeperBot.ts",
    "bot:relayer-from-chiado": "NODE_NO_WARNINGS=1 NODE_OPTIONS=--experimental-fetch hardhat run ./scripts/disputeRelayerBotFromChiado.ts",
    "bot:relayer-from-sepolia": "NODE_NO_WARNINGS=1 NODE_OPTIONS=--experimental-fetch hardhat run ./scripts/disputeRelayerBotFromSepolia.ts",
    "bot:relayer-from-hardhat": "NODE_NO_WARNINGS=1 NODE_OPTIONS=--experimental-fetch hardhat run ./scripts/disputeRelayerBotFromHardhat.ts",
    "bot:disputor": "NODE_NO_WARNINGS=1 yarn hardhat run ./scripts/disputeCreatorBot.ts",
    "etherscan-verify": "hardhat etherscan-verify",
    "etherscan-verify-proxies": "scripts/verifyProxies.sh",
    "sourcify": "hardhat sourcify --write-failing-metadata",
    "size": "hardhat size-contracts --no-compile",
    "watch": "hardhat watch",
    "natspec-smells": "natspec-smells",
    "docgen": "hardhat docgen",
    "populate:courts:devnet": "hardhat populate:courts --from v2_devnet  --network arbitrumSepoliaDevnet",
    "populate:courts:testnet": "hardhat populate:courts --from v2_testnet  --network arbitrumSepolia",
    "populate:courts:mainnet": "hardhat populate:courts --from v2_mainnet  --network arbitrum",
    "populate:policiesUris": "scripts/setPoliciesURIs.sh config/policies.v2.{devnet,testnet,mainnet}.json",
    "populate:policies:devnet": "hardhat populate:policy-registry --from v2_devnet --network arbitrumSepoliaDevnet",
    "populate:policies:testnet": "hardhat populate:policy-registry --from v2_testnet --network arbitrumSepolia",
    "populate:policies:mainnet": "hardhat populate:policy-registry --from v2_mainnet --network arbitrum",
    "release:patch": "scripts/publish.sh patch",
    "release:minor": "scripts/publish.sh minor",
    "release:major": "scripts/publish.sh major",
    "tenderly-verify": "hardhat tenderly:verify",
    "build:all": "rm -rf dist contracts && mkdir -p dist && yarn build:cjs && yarn build:esm && yarn build:types && yarn build:contracts",
    "build:contracts": "scripts/build-contracts.sh",
    "pin": "scripts/pin.sh",
    "unpin": "scripts/pin.sh --unpin",
    "build:cjs": "tsc --project tsconfig-release.json --module CommonJS --moduleResolution Node --outDir ./dist/cjs && echo '{\"type\": \"commonjs\"}' > ./dist/cjs/package.json",
    "build:esm": "mkdir -p dist/esm && echo '{\"type\": \"module\"}' > ./dist/esm/package.json && tsc --project tsconfig-release.json --module ES2022 --moduleResolution Node --outDir ./dist/esm",
    "build:types": "tsc --project tsconfig-release.json --declarationDir ./dist/types --emitDeclarationOnly --declaration --declarationMap",
    "check-style": "eslint . --no-error-on-unmatched-pattern",
    "check-types": "tsc --noEmit"
  },
  "prettier": "@kleros/kleros-v2-prettier-config",
  "devDependencies": {
    "@defi-wonderland/natspec-smells": "^1.1.6",
    "@kleros/kleros-v2-eslint-config": "workspace:^",
    "@kleros/kleros-v2-prettier-config": "workspace:^",
    "@kleros/kleros-v2-tsconfig": "workspace:^",
    "@logtail/pino": "^0.5.0",
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.2",
    "@nomiclabs/hardhat-solhint": "^4.1.2",
    "@openzeppelin/upgrades-core": "^1.44.2",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.24",
    "@types/sinon": "^17.0.4",
    "@wagmi/cli": "^2.3.2",
    "abitype": "^0.10.3",
    "chai": "^4.5.0",
    "dotenv": "^16.6.1",
    "eslint": "^9.15.0",
    "eslint-plugin-chai-friendly": "^1.2.0",
    "ethereumjs-util": "^7.1.5",
    "ethers": "^6.15.0",
    "gluegun": "^5.2.0",
    "graphql": "^16.9.0",
    "graphql-request": "^7.1.2",
    "hardhat": "2.26.5",
    "hardhat-contract-sizer": "^2.10.1",
    "hardhat-deploy": "^1.0.4",
    "hardhat-deploy-ethers": "^0.4.2",
    "hardhat-deploy-tenderly": "^0.2.1",
    "hardhat-docgen": "^1.3.0",
    "hardhat-gas-reporter": "^2.3.0",
    "hardhat-tracer": "^3.4.0",
    "hardhat-watcher": "^2.5.0",
    "pino": "^8.21.0",
    "pino-pretty": "^10.3.1",
    "prettier": "^3.3.3",
    "prettier-plugin-solidity": "^1.4.2",
    "shelljs": "^0.8.5",
    "sinon": "^20.0.0",
    "solhint-plugin-prettier": "^0.1.0",
    "solidity-coverage": "^0.8.16",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@chainlink/contracts": "^1.4.0",
    "@kleros/vea-contracts": "^0.7.0",
    "@openzeppelin/contracts": "^5.5.0",
    "@shutter-network/shutter-sdk": "0.0.2",
    "isomorphic-fetch": "^3.0.0"
  },
  "peerDependencies": {
    "ethers": "^6.15.0",
    "viem": "^2.24.1"
  },
  "peerDependenciesMeta": {
    "ethers": {
      "optional": true
    },
    "viem": {
      "optional": true
    }
  },
  "stableVersion": "0.12.0"
}
